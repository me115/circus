{
  "name": "my-video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/bundler": "^4.0.421",
    "@remotion/cli": "4.0.421",
    "@remotion/renderer": "^4.0.421",
    "@remotion/tailwind-v4": "4.0.421",
    "@remotion/transitions": "^4.0.421",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.421",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.421",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.6.0",
    "typescript": "5.9.3"
  },
  "scripts": {
    "start": "remotion studio",
    "dev": "remotion studio",
    "render": "remotion render GeminiStyleDemo out/gemini-style-demo.mp4",
    "render:skill": "node scripts/render_from_spec.ts --spec src/specs/skill.timeline.json --out out/video.mp4",
    "qa:eval": "python3 qa/evaluate_video.py --video out/video.mp4 --manifest out/manifest.json --expected_text qa/expected_script.txt --out out/report.json",
    "qa:loop": "python3 qa/optimize_loop.py --spec src/specs/skill.timeline.json --target 60 --max_iter 10",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "generate:assets": "node scripts/generate-placeholders.mjs",
    "postinstall": "npm run generate:assets"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "index.js",
  "author": ""
}
